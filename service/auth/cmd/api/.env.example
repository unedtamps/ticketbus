# Auth Service
# Copy this file to .env (direnv loads it via .envrc) and fill in the values.

APP_ENV=development
PORT=8081
DATABASE_URL=postgres://ticketsaas:ticketsaas@localhost:5432/auth_db?sslmode=disable

# ECDSA key pair used to sign/verify access tokens (PEM format).
JWT_PRIVATE_KEY=<ecdsa-private-key-pem>
JWT_PUBLIC_KEY=<ecdsa-public-key-pem>

# Admin accounts auto-seeded idempotently on every startup (existing emails
# are skipped). Leave empty to skip seeding. Each entry requires email,
# password and name.
ADMIN_SEEDS="[{\"email\":\"admin@test.com\",\"password\":\"Admin123!\",\"name\":\"Admin\"},{\"email\":\"admin2@test.com\",\"password\":\"SuperAdmin123!\",\"name\":\"Admin 2\"}]"

# OpenTelemetry traces. Leave OTEL_EXPORTER_OTLP_ENDPOINT unset (or empty) to
# disable tracing entirely — the SDK then installs no tracer provider and every
# span becomes a no-op. Point it at the collector from `make obs-up`:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# The standard OTEL_* variables are honoured, so this also works unchanged
# against a hosted backend later.
