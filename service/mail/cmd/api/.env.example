# Mail Service
# Copy this file to .env (direnv loads it via .envrc) and fill in the values.

APP_ENV=development
PORT=8084
KAFKA_BROKERS=localhost:9092
CONSUMER_CONCURRENCY=4

# SMTP delivery. In dev this is the MailDev container (docker compose up maildev):
# SMTP on 1025, inbox web UI on http://localhost:1080. MailDev accepts any
# sender and no credentials.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="TicketBus <no-reply@ticketbus.local>"

# Observability (optional; no-op when unset).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
WEB_BASE_URL=http://localhost:3000
