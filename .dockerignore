# Keep the image build context small for both the backend images and the
# standalone Next.js frontend image. Without this, builds ship node_modules and
# .git (~700 MB) even though the Dockerfiles never read them.

# VCS / CI
.git
.github
.githooks

# Frontend build output and dependencies. The source under apps/web is needed
# for the web image; only generated output is excluded.
node_modules
**/node_modules
.next
**/.next
*.tsbuildinfo

# Local artifacts and runtime state
bin
logs
volumes
coverage
coverage.*
*.log

# Tests and local tooling
tests
docs
observability
scripts
traefik

# Generated keys and local environment files (never bake secrets into images)
docker/e2e/keys
.env
.env.*
**/.env
**/.env.*
**/.envrc
**/*.pem

# Editor / OS noise
.zcode
.idea
.vscode
.DS_Store
