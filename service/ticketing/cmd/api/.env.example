# Ticketing Service
# Copy this file to .env (direnv loads it via .envrc) and fill in the values.

APP_ENV=development
PORT=8082
DATABASE_URL=postgres://ticketsaas:ticketsaas@localhost:5433/ticketing_db?sslmode=disable
KAFKA_BROKERS=localhost:9092

# Booking hold duration in seconds. Seats are released when the payment
# expires (payment service poll) — there is no local sweeper.
RESERVATION_TTL=900
CONSUMER_CONCURRENCY=4
OUTBOX_CONCURRENCY=4
OUTBOX_POLL_MS=200

# Payment service (sync transaction creation during reserve).
# INTERNAL_API_KEY must match the payment service value.
PAYMENT_SERVICE_URL=http://localhost:8084
PAYMENT_TIMEOUT_SEC=10
INTERNAL_API_KEY=dev-internal-key
