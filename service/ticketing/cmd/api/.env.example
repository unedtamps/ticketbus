# Ticketing Service
# Copy this file to .env (direnv loads it via .envrc) and fill in the values.

APP_ENV=development
PORT=8082
DATABASE_URL=postgres://ticketbus:ticketbus@localhost:5433/ticketing_db?sslmode=disable
KAFKA_BROKERS=localhost:9092

# Booking hold duration in seconds. Seats are released when the payment
# expires (payment service poll) — there is no local sweeper.
# RESERVATION_TTL is how long a seat hold lives. It must exceed the gateway's
# ten-minute minimum session lifetime plus GATEWAY_EXPIRY_BUFFER_MIN, so the
# gateway session always expires before the hold and a payment made inside the
# hold is always honoured — even if the event has already ended.
RESERVATION_TTL=1200
CONSUMER_CONCURRENCY=4
OUTBOX_CONCURRENCY=4
OUTBOX_POLL_MS=200

# Payment service. Reserve writes a payment.initiate outbox row in the same
# transaction as the booking; a background REST dispatcher then calls the
# payment service's POST /api/payments/internal to create the transaction.
# INTERNAL_API_KEY must match the payment service value.
PAYMENT_SERVICE_URL=http://localhost:8084
PAYMENT_TIMEOUT_SEC=10
INTERNAL_API_KEY=dev-internal-key
# How often (ms) the dispatcher looks for undelivered payment.initiate rows.
REST_DISPATCH_POLL_MS=200

# Object storage (S3-compatible — Cloudflare R2 in production) for event
# photos. Uploads happen server-side; downloads go straight to the bucket's
# public base URL, so the store only needs write credentials here.
#   S3_ENDPOINT     R2: <account_id>.r2.cloudflarestorage.com (no scheme)
#   S3_PUBLIC_URL   the bucket's public base URL — the R2.dev subdomain or a
#                   custom domain, enabled in the R2 dashboard (Settings ->
#                   Public access). Example: https://pub-xxx.r2.dev
S3_ENDPOINT=<account_id>.r2.cloudflarestorage.com
S3_SECURE=true
S3_REGION=auto
S3_ACCESS_KEY_ID=<r2 access key id>
S3_SECRET_ACCESS_KEY=<r2 secret access key>
S3_BUCKET_NAME=ticketbus-events
S3_PUBLIC_URL=https://pub-xxx.r2.dev

# OpenTelemetry traces. Leave OTEL_EXPORTER_OTLP_ENDPOINT unset (or empty) to
# disable tracing entirely — the SDK then installs no tracer provider and every
# span becomes a no-op. Point it at the collector from `make obs-up`:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# The standard OTEL_* variables are honoured, so this also works unchanged
# against a hosted backend later.
# Metrics ride the same endpoint: when it is set, the service also exports HTTP
# request rate/duration and PostgreSQL query duration/errors, which the collector
# exposes for Prometheus to scrape. Defaults to a 60s export interval; override
# with (milliseconds) if you want faster local feedback:
#   OTEL_METRIC_EXPORT_INTERVAL=15000
