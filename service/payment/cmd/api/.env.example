# Payment Service
# Copy this file to .env (direnv loads it via .envrc) and fill in the values.

APP_ENV=development
PORT=8084
DATABASE_URL=postgres://ticketbus:ticketbus@localhost:5435/payment_db?sslmode=disable
KAFKA_BROKERS=localhost:9092

# URL of the webhook endpoint that the (mock) provider notifies.
WEBHOOK_BASE_URL=http://localhost:8000/api/payments/webhook
CONSUMER_CONCURRENCY=4
OUTBOX_CONCURRENCY=4
OUTBOX_POLL_MS=200

# Provider: "mock" for dev/tests, "xendit" for the sandbox/live gateway.
PROVIDER=mock

# Xendit configuration — REQUIRED when PROVIDER=xendit.
# Sandbox key format: xnd_development_...
XENDIT_API_KEY=
XENDIT_BASE_URL=https://api.xendit.co/v1

# Payouts API (the new Payouts API, not legacy Disbursements). XENDIT_BASE_URL
# above points at /v1 for Payment Sessions; payouts use the API root.
XENDIT_PAYOUT_BASE_URL=https://api.xendit.co
XENDIT_PAYOUT_PATH=/v2/payouts
# How often the payout dispatcher looks for undelivered disbursement jobs.
PAYOUT_DISPATCH_POLL_MS=200
# Refund executor: how often pending refunds with a registered destination are
# claimed and paid out via Payouts.
REFUND_SWEEP_SEC=60
# Refund endpoint path on the Xendit API root (api.xendit.co/refunds).
XENDIT_REFUND_PATH=/refunds
# How often payouts already sent to the gateway are polled for their final
# status (GET /v2/payouts/{id}) — the safety net for payout webhooks that
# never arrived. 0 disables reconciliation.
PAYOUT_RECONCILE_SEC=30

# Payout settlement is asynchronous at the gateway (PENDING -> COMPLETED or
# FAILED). Register the payout callback URL in the Xendit dashboard
# (Settings > Developers > Webhooks, PAYOUT section) as
# {PUBLIC_URL}/api/payments/webhook/payout — verified with the same
# WEBHOOK_CALLBACK_TOKEN below. Missed webhooks are covered by the
# reconciliation poll.

# Shared webhook verification token (REQUIRED for both providers). The
# gateway must send this as the x-callback-token header on webhooks.
WEBHOOK_CALLBACK_TOKEN=dev-webhook-token

# Internal service-to-service auth.
# Must match INTERNAL_API_KEY in the ticketing service.
INTERNAL_API_KEY=dev-internal-key

# The gateway session expires together with the booking hold, so a customer
# can never pay after their seats were released. Sessions are only created
# while more than the gateway's ten-minute minimum remains.
# Expiry sweeper interval (seconds). It only picks up transactions the gateway
# will never report: never-initiated ones, plus sessions whose webhook was lost.
EXPIRY_POLL_SEC=30

# Payment channels shown on the Xendit hosted checkout page (comma-separated).
# Optional: Xendit channel codes (comma-separated). Not sent to Xendit — the
# gateway enables all channels activated for the account. Kept for the mock
# provider / future dashboard control.
# PAYMENT_METHODS=ID_QRIS,ID_OVO

# OpenTelemetry traces. Leave OTEL_EXPORTER_OTLP_ENDPOINT unset (or empty) to
# disable tracing entirely — the SDK then installs no tracer provider and every
# span becomes a no-op. Point it at the collector from `make obs-up`:
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# The standard OTEL_* variables are honoured, so this also works unchanged
# against a hosted backend later.
# Metrics ride the same endpoint: when it is set, the service also exports HTTP
# request rate/duration and PostgreSQL query duration/errors, which the collector
# exposes for Prometheus to scrape. Defaults to a 60s export interval; override
# with (milliseconds) if you want faster local feedback:
#   OTEL_METRIC_EXPORT_INTERVAL=15000
